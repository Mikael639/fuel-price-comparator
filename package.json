    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.4"
