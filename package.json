{
  "name": "fuel-price-comparator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "node server/proxy-server.mjs",
    "dev:full": "concurrently \"npm:dev:proxy\" \"npm:dev\"",
    "build": "tsc -b && vite build",
